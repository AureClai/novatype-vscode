{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Typst",
  "scopeName": "source.typst",
  "patterns": [
    { "include": "#comment" },
    { "include": "#raw-block" },
    { "include": "#raw-inline" },
    { "include": "#math" },
    { "include": "#label" },
    { "include": "#reference" },
    { "include": "#heading" },
    { "include": "#list" },
    { "include": "#code-expression" },
    { "include": "#bold" },
    { "include": "#italic" },
    { "include": "#escape" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.typst",
          "match": "//.*$"
        },
        {
          "name": "comment.block.typst",
          "begin": "/\\*",
          "end": "\\*/",
          "contentName": "comment.block.typst"
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.typst",
      "match": "\\\\[\\\\/*_`#$@<>\\[\\]{}~=\"']"
    },
    "raw-block": {
      "name": "markup.raw.block.typst",
      "begin": "```",
      "end": "```"
    },
    "raw-inline": {
      "name": "markup.raw.inline.typst",
      "begin": "`",
      "end": "`"
    },
    "math": {
      "name": "markup.math.typst",
      "begin": "\\$",
      "end": "\\$",
      "patterns": [
        {
          "name": "keyword.operator.math.typst",
          "match": "[+\\-*/=<>^_&]"
        },
        {
          "name": "constant.numeric.typst",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "support.function.math.typst",
          "match": "\\b[a-zA-Z][a-zA-Z0-9]*(?=\\()"
        }
      ]
    },
    "heading": {
      "name": "markup.heading.typst",
      "match": "^\\s*(=+)\\s+.*$"
    },
    "bold": {
      "name": "markup.bold.typst",
      "begin": "(?<=\\s|^)\\*(?=\\S)",
      "end": "(?<=\\S)\\*(?=\\s|$|[.,;:!?)])",
      "patterns": [
        { "include": "#italic" },
        { "include": "#code-expression" },
        { "include": "#reference" },
        { "include": "#escape" }
      ]
    },
    "italic": {
      "name": "markup.italic.typst",
      "begin": "(?<=\\s|^)_(?=\\S)",
      "end": "(?<=\\S)_(?=\\s|$|[.,;:!?)])",
      "patterns": [
        { "include": "#bold" },
        { "include": "#code-expression" },
        { "include": "#reference" },
        { "include": "#escape" }
      ]
    },
    "list": {
      "patterns": [
        {
          "name": "markup.list.unnumbered.typst",
          "match": "^\\s*-\\s+"
        },
        {
          "name": "markup.list.numbered.typst",
          "match": "^\\s*\\+\\s+"
        },
        {
          "name": "markup.list.numbered.typst",
          "match": "^\\s*\\d+\\.\\s+"
        },
        {
          "name": "markup.quote.typst",
          "match": "^\\s*>\\s+"
        }
      ]
    },
    "label": {
      "name": "entity.name.tag.label.typst",
      "match": "<[a-zA-Z_][a-zA-Z0-9_:-]*>"
    },
    "reference": {
      "name": "entity.name.tag.reference.typst",
      "match": "@[a-zA-Z_][a-zA-Z0-9_:-]*"
    },
    "string": {
      "name": "string.quoted.double.typst",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.typst",
          "match": "\\\\."
        }
      ]
    },
    "code-expression": {
      "patterns": [
        {
          "name": "keyword.control.typst",
          "match": "#(if|else|for|while|let|set|show|import|include|return|break|continue)\\b"
        },
        {
          "comment": "Function call: #name(...)",
          "begin": "(#[a-zA-Z_][a-zA-Z0-9_.-]*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "support.function.typst" },
            "2": { "name": "punctuation.paren.open.typst" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.paren.close.typst" }
          },
          "patterns": [
            { "include": "#code-inner" }
          ]
        },
        {
          "comment": "Function call with content block: #name[...]",
          "begin": "(#[a-zA-Z_][a-zA-Z0-9_.-]*)\\s*(\\[)",
          "beginCaptures": {
            "1": { "name": "support.function.typst" },
            "2": { "name": "punctuation.bracket.open.typst" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.bracket.close.typst" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "comment": "Standalone code expression: #name",
          "name": "support.function.typst",
          "match": "#[a-zA-Z_][a-zA-Z0-9_.-]*"
        }
      ]
    },
    "code-inner": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        {
          "name": "constant.numeric.typst",
          "match": "\\b\\d+(\\.\\d+)?(pt|mm|cm|in|em|%)?\\b"
        },
        {
          "name": "constant.language.typst",
          "match": "\\b(true|false|none)\\b"
        },
        {
          "name": "keyword.operator.typst",
          "match": "[+\\-*/=<>!]=?|=>|\\.\\.|\\.(?=[a-zA-Z])"
        },
        {
          "comment": "Nested function call",
          "begin": "([a-zA-Z_][a-zA-Z0-9_.-]*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "support.function.typst" },
            "2": { "name": "punctuation.paren.open.typst" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.paren.close.typst" }
          },
          "patterns": [
            { "include": "#code-inner" }
          ]
        },
        {
          "comment": "Content block inside code",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "name": "variable.parameter.typst",
          "match": "[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*:)"
        }
      ]
    }
  }
}
