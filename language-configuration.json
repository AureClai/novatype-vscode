{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "$", "close": "$" },
    { "open": "*", "close": "*" },
    { "open": "_", "close": "_" },
    { "open": "`", "close": "`" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["$", "$"],
    ["*", "*"],
    ["_", "_"],
    ["`", "`"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*[-+]\\s.*$|^\\s*\\d+\\.\\s.*$|.*[\\[\\(\\{]\\s*$",
    "decreaseIndentPattern": "^\\s*[\\]\\)\\}]"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*- .+$",
      "action": { "indent": "none", "appendText": "- " }
    },
    {
      "beforeText": "^\\s*\\+ .+$",
      "action": { "indent": "none", "appendText": "+ " }
    },
    {
      "beforeText": "^\\s*\\d+\\. .+$",
      "action": { "indent": "none", "appendText": "1. " }
    },
    {
      "beforeText": "^\\s*- $",
      "action": { "indent": "outdent", "removeText": 2 }
    },
    {
      "beforeText": "^\\s*\\+ $",
      "action": { "indent": "outdent", "removeText": 2 }
    },
    {
      "beforeText": "^\\s*\\d+\\. $",
      "action": { "indent": "outdent", "removeText": 3 }
    }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
